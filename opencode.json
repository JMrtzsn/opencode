{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "github-copilot/gpt-5.6-sol",
  "plugin": ["@dietrichgebert/ponytail"],

  "compaction": {
    "auto": true,
    "prune": true
  },

  "permission": {
    "bash": {
      "git commit*": "ask",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git checkout --*": "deny",
      "git clean*": "deny"
    }
  }
}
